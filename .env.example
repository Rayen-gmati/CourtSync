# ============================================================================
# CourtSync — variables d'environnement (exemple, sans valeurs réelles)
# Copier vers .env.local puis renseigner. JAMAIS committer de vraies valeurs.
# ============================================================================

# --- Supabase (projet → Settings → API) ---
# URL publique du projet, ex : https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon publique (safe côté client, limitée par la RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SECRÈTE, côté serveur uniquement (routes /api/*).
# Ne jamais l'exposer côté client ni la committer. À régénérer en cas de fuite.
SUPABASE_SERVICE_ROLE_KEY=

# --- Météo (optionnel : sans clé, les badges météo sont simplement masqués) ---
# Clé API OpenWeatherMap (plan gratuit suffisant)
OPENWEATHER_API_KEY=
# Coordonnées du club (défauts intégrés : Tunis)
WEATHER_LAT=36.8065
WEATHER_LON=10.1815
